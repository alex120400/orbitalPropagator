  <ProjectMissionSequence>
    <ProjectExternals />
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>FreeForm</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Reimport and Propagate Ephemeris

// Create core objects
Array      stateInEarthFixedFrame[3];
Ephemeris  interpolatedEphem;
Spacecraft spacecraft2;
Array      stateICRF[3];

// Set the step size to 2 minutes to force interpolation between Ephemeris vectors
spacecraft2.Propagator.StepSize = TimeSpan.FromSeconds(60);

// Load the ephemeris file 
interpolatedEphem.LoadEphemeris("test.FFEphem");
spacecraft2.Epoch = interpolatedEphem.StartEpoch;
Report spacecraft2.PropagatorType;

// Create and configure DataTableWindow object so we can give them meaningful names
DataTableWindow interpolatedReport({spacecraft2.EpochText, spacecraft2.Position, spacecraft2.Velocity});
interpolatedReport.WindowTitle = "Interpolated Spacecraft Data (From Ephemeris)";

While (spacecraft2.Epoch <= interpolatedEphem.EndEpoch);	 
	// Pull the state vector data out of the ephemeris object (in the Earth-Fixed frame)
	stateInEarthFixedFrame = interpolatedEphem.GetInterpolatedVectorData(spacecraft2.Epoch, {0,1,2}); 

	// Convert the Spacecraft's state from the Earth-Fixed frame at the spacecraft's epoch to ICRF 
	stateICRF = PositionConvert(4, 1, spacecraft2.Epoch, stateInEarthFixedFrame); 

	// Assign the ICRF state to the Spacecraft object 
	spacecraft2.Position = stateICRF;

	// Update output
	//spacecraft2PosSeries.AddPoints(spacecraft2.ElapsedTime.ToHours, spacecraft2.Position.Norm());
	//Update plotWindowPosition;
	Update interpolatedReport;

	Step spacecraft2;
End;]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[// Reimport and Propagate Ephemeris

// Create core objects
Array      stateInEarthFixedFrame[3];
Ephemeris  interpolatedEphem;
Spacecraft spacecraft2;
Array      stateICRF[3];

// Set the step size to 2 minutes to force interpolation between Ephemeris vectors
spacecraft2.Propagator.StepSize = TimeSpan.FromSeconds(60);

// Load the ephemeris file 
interpolatedEphem.LoadEphemeris("test.FFEphem");
spacecraft2.Epoch = interpolatedEphem.StartEpoch;
Report spacecraft2.PropagatorType;

// Create and configure DataTableWindow object so we can give them meaningful names
DataTableWindow interpolatedReport({spacecraft2.EpochText, spacecraft2.Position, spacecraft2.Velocity});
interpolatedReport.WindowTitle = "Interpolated Spacecraft Data (From Ephemeris)";

While (spacecraft2.Epoch <= interpolatedEphem.EndEpoch);	 
	// Pull the state vector data out of the ephemeris object (in the Earth-Fixed frame)
	stateInEarthFixedFrame = interpolatedEphem.GetInterpolatedVectorData(spacecraft2.Epoch, {0,1,2}); 

	// Convert the Spacecraft's state from the Earth-Fixed frame at the spacecraft's epoch to ICRF 
	stateICRF = PositionConvert(4, 1, spacecraft2.Epoch, stateInEarthFixedFrame); 

	// Assign the ICRF state to the Spacecraft object 
	spacecraft2.Position = stateICRF;

	// Update output
	//spacecraft2PosSeries.AddPoints(spacecraft2.ElapsedTime.ToHours, spacecraft2.Position.Norm());
	//Update plotWindowPosition;
	Update interpolatedReport;

	Step spacecraft2;
End;]]></ProjectScript>
