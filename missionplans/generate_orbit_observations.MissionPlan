  <ProjectMissionSequence>
    <ProjectExternals />
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Define BlackJackFile Procedure</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[Define Procedure ReportPSOObservationToBlackJackStructure(Spacecraft sc, ReportInterface blackJackTrackingData);
	TimeSpan modified_epoch = TimeTools.ConvertTime(sc.Epoch, "UTC", "MJD GSFC", "GPS", "MJD GSFC"); // adds necessary 18 seconds to compensate calender conversion tai -> utc
	String timeString = modified_epoch.ConvertToCalendarDate("YYYY MM DD hh mm ss.ss");
	Array stateInEarthFixedFrame[6];
	stateInEarthFixedFrame = PositionVelocityConvert(1, 4, sc.Epoch, {sc.Position, sc.Velocity});
	Report "0", 
	stateInEarthFixedFrame[0].Format("%13.5f"), 
	stateInEarthFixedFrame[1].Format("%13.5f"), 
	stateInEarthFixedFrame[2].Format("%13.5f"), 
	stateInEarthFixedFrame[3].Format("%12.7f"),	
	stateInEarthFixedFrame[4].Format("%12.7f"), 
	stateInEarthFixedFrame[5].Format("%12.7f"), 
	" ", 
	timeString to blackJackTrackingData without headers without pad;
EndProcedure;]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Python Input</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// define 
FF_SolarSystem.DefaultEarthOrientationParametersFile = "./Support_Files/earth_orientation_parameters_celestrak.csv";


/* ######## Python Input ######## */
String SpaceCraftName; // = "OBJECT AC";
TimeSpan obs_length; // = TIMESPAN(3 days);

ApiLabel "Python-Input"; // In app, define at least Spacecraftname and obs_length variables above via python

If (FileSystem.Exists("./tmp") != 1);
	FileSystem.CreateDirectory("./tmp"); // data will be put here, app should create it automatically but for manual tests required too
End;







]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup SpaceCraft, Variables and Output-FIle</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[/* ######## TLE & Spacecraft setup ######## */
TwoLineElement spacecraftTLE;
String TLEFile = "TLE_export.tle";
SGP4 PropagatorSPG4;
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(Spacecraft1);

Spacecraft1.SetPropagatorType(TypeOf(SGP4)); //change default prpagator to SGP4 for orbit
Spacecraft1.Propagator.StepSize = TIMESPAN(20 seconds); // must be same as formation!!

/* ######## Variables ######## */
//Constant Variable T = 2*Constants.Pi/Spacecraft1.MeanMotion; // orbit duration
//TimeSpan orbit_duration = TimeSpan.FromSeconds(T);
//TimeSpan two_orbits_duration = TimeSpan.FromSeconds(1.4*T); // should be 2*T
TimeSpan tle_epoch = Spacecraft1.Epoch;

/* ######## BlackJack-like output file ######## */
String asa_tracking_name = SpaceCraftName.Replace(" ", "-");
asa_tracking_name = asa_tracking_name.Replace("/", "-");
asa_tracking_name = asa_tracking_name.Replace("\", "-");
asa_tracking_name = asa_tracking_name.Replace("<", "-");
asa_tracking_name = asa_tracking_name.Replace(">", "-");
asa_tracking_name = asa_tracking_name.Replace(":", "-");
asa_tracking_name = asa_tracking_name.Replace("*", "-");
asa_tracking_name = asa_tracking_name.Replace("?", "-");
asa_tracking_name = asa_tracking_name.Replace('"', "-");

String PSO_pseudo_blackjack_file_name = "tmp/pseudo_pointobservations_"+asa_tracking_name+"_blackjack.txt";
ReportInterface PSO_pseudo_data(PSO_pseudo_blackjack_file_name);




]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="false">
        <Label>Setup Observation objects and Formation</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Set up Observation objects
String PSO_blackjack_file_name = "tmp/pointobservations_"+asa_tracking_name+"_blackjack.txt";
List<PointSolutionObservation> PointSolutionObservations;
BlackJackPointSolutionFile BlackJackPointSolutionFile1;



// GPS Formation
GPS.LoadRinexNavFile(gps_ephemeris_file);
// Set up Line-of-Sight Vectors
List<Vector> GPSVectors;
GPSVectors.Count = GPS.Count;

For i = 0 to GPS.Count-1;
	GPS[i].Propagator.StepSize =  TIMESPAN(10 seconds); // must be same as spacecraft!!
	
	GPS[i].Color = ColorTools.LimeGreen;

	GPSVectors[i].BuildVector(9, Spacecraft1, GPS[i]);
	GPSVectors[i].Color = GPS[i].Color;
End;

ThreeDView.AddObject(GPSVectors);]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="false" comment="Use either this, if required Rinex2 file is available, needs (4)">
        <Label>Propagate spacecraft and make observations</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[//https://cddis.nasa.gov/archive/gnss/data/daily/2026/brdc/brdc0110.26n.gz // gps only
//https://cddis.nasa.gov/archive/gnss/data/daily/2026/brdc/brdc0110.26g.gz // glonass only
//https://cddis.nasa.gov/archive/gnss/data/hourly/2026/012/hour0120.26n.gz
// https://cddis.nasa.gov/archive/gnss/data/daily/2026/brdc/BRDC00IGS_R_20260110000_01D_MN.rnx.gz

// synch GNSS epochs
GPS.StepToEpoch(Spacecraft1.Epoch);

// propagate for two orbits
While (Spacecraft1.Epoch <= (tle_epoch + two_orbits_duration));
	//View Spacecraft1;
	// ###### generiere tracking data ######
	
	// Reset Vectors
	For i = 0 to GPSVectors.Count-1;
		GPSVectors[i].Active = 0;
	End;
	// At each step, add a new element to the List of PointSolution Observations
	// and simulate tracking data

	PointSolutionObservations.Count++;

	i = PointSolutionObservations.Count - 1;

	PointSolutionObservations[i].SetObjectBeingObserved(Spacecraft1);
	PointSolutionObservations[i].SetObserver(Spacecraft1.GNSSReceivers[0]);

	PointSolutionObservations[i].UseX = 1;
	PointSolutionObservations[i].UseY = 1;
	PointSolutionObservations[i].UseZ = 1;
	PointSolutionObservations[i].UseVX = 1;
	PointSolutionObservations[i].UseVY = 1;
	PointSolutionObservations[i].UseVZ = 1;

	// Simulate PointSolution data, checking visibility from both GNSS constellations
	Spacecraft1.SimulateTrackingData(GPS, PointSolutionObservations[i], 0);
	
	// report spacecraft data to file
	Call ReportPSOObservationToBlackJackStructure(Spacecraft1, PSO_pseudo_data);
	
	// Turn on vectors of GNSS satellites in view
	For i = 0 to GPS.Count-1;
		If (Spacecraft1.Contact(GPS[i], GPS[i].Sensors[0]));
			GPSVectors[i].Active = 1;
		End;
	End;
	
	Update ThreeDView; 
	Step Spacecraft1;
	Step GPS;
	
End;

// Write List of PointSolutionObservations to a BlackJack output file
BlackJackPointSolutionFile1.WriteValidDataToFile(PSO_blackjack_file_name, PointSolutionObservations);]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true" comment="Or use this to use simple pseudo observations of propagated spacecraft">
        <Label>Propagate and make pseudo observations</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[
While (Spacecraft1.Epoch <= (tle_epoch + obs_length));
	//View Spacecraft1;
	// ###### generiere tracking data ###### 
	Call ReportPSOObservationToBlackJackStructure(Spacecraft1, PSO_pseudo_data);
	Step Spacecraft1;
End;]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[Define Procedure ReportPSOObservationToBlackJackStructure(Spacecraft sc, ReportInterface blackJackTrackingData);
	TimeSpan modified_epoch = TimeTools.ConvertTime(sc.Epoch, "UTC", "MJD GSFC", "GPS", "MJD GSFC"); // adds necessary 18 seconds to compensate calender conversion tai -> utc
	String timeString = modified_epoch.ConvertToCalendarDate("YYYY MM DD hh mm ss.ss");
	Array stateInEarthFixedFrame[6];
	stateInEarthFixedFrame = PositionVelocityConvert(1, 4, sc.Epoch, {sc.Position, sc.Velocity});
	Report "0", 
	stateInEarthFixedFrame[0].Format("%13.5f"), 
	stateInEarthFixedFrame[1].Format("%13.5f"), 
	stateInEarthFixedFrame[2].Format("%13.5f"), 
	stateInEarthFixedFrame[3].Format("%12.7f"),	
	stateInEarthFixedFrame[4].Format("%12.7f"), 
	stateInEarthFixedFrame[5].Format("%12.7f"), 
	" ", 
	timeString to blackJackTrackingData without headers without pad;
EndProcedure;
// define 
FF_SolarSystem.DefaultEarthOrientationParametersFile = "./Support_Files/earth_orientation_parameters_celestrak.csv";


/* ######## Python Input ######## */
String SpaceCraftName; // = "OBJECT AC";
TimeSpan obs_length; // = TIMESPAN(3 days);

ApiLabel "Python-Input"; // In app, define at least Spacecraftname and obs_length variables above via python

If (FileSystem.Exists("./tmp") != 1);
	FileSystem.CreateDirectory("./tmp"); // data will be put here, app should create it automatically but for manual tests required too
End;








/* ######## TLE & Spacecraft setup ######## */
TwoLineElement spacecraftTLE;
String TLEFile = "TLE_export.tle";
SGP4 PropagatorSPG4;
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(Spacecraft1);

Spacecraft1.SetPropagatorType(TypeOf(SGP4)); //change default prpagator to SGP4 for orbit
Spacecraft1.Propagator.StepSize = TIMESPAN(20 seconds); // must be same as formation!!

/* ######## Variables ######## */
//Constant Variable T = 2*Constants.Pi/Spacecraft1.MeanMotion; // orbit duration
//TimeSpan orbit_duration = TimeSpan.FromSeconds(T);
//TimeSpan two_orbits_duration = TimeSpan.FromSeconds(1.4*T); // should be 2*T
TimeSpan tle_epoch = Spacecraft1.Epoch;

/* ######## BlackJack-like output file ######## */
String asa_tracking_name = SpaceCraftName.Replace(" ", "-");
asa_tracking_name = asa_tracking_name.Replace("/", "-");
asa_tracking_name = asa_tracking_name.Replace("\", "-");
asa_tracking_name = asa_tracking_name.Replace("<", "-");
asa_tracking_name = asa_tracking_name.Replace(">", "-");
asa_tracking_name = asa_tracking_name.Replace(":", "-");
asa_tracking_name = asa_tracking_name.Replace("*", "-");
asa_tracking_name = asa_tracking_name.Replace("?", "-");
asa_tracking_name = asa_tracking_name.Replace('"', "-");

String PSO_pseudo_blackjack_file_name = "tmp/pseudo_pointobservations_"+asa_tracking_name+"_blackjack.txt";
ReportInterface PSO_pseudo_data(PSO_pseudo_blackjack_file_name);





