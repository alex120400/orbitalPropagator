    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Define Procedure ASA Tracking File</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[Define Procedure ReportObservationToASAStructure(Spacecraft sc, GroundStationObservation gso, ReportInterface ASATrackingData);
	Variable mjdUTC = sc.EpochUTC.ToDays + 29999.5; // spacecraft default ref:1941 to asa ref: 1858
	Variable elevation = gso.Elevation.ObservedValue * 180 / Constants.Pi;
	Variable azimuth = gso.Azimuth.ObservedValue * 180 / Constants.Pi;
	Variable RA = 0.0; //(sc.RA / 180) * Constants.Pi; // not light time corrected!
	Variable DE = 0.0; //(sc.DEC / 180) * Constants.Pi; // not light time corrected!
	Variable emptyVar = 0.0;
	Report mjdUTC.Format("%14.8f"), " ", RA.Format("%12.9f"),DE.Format("%13.9f"),"  000.0000  000.0000", azimuth.Format("%12.6f"), elevation.Format("%12.6f") to ASATrackingData without headers without pad;
EndProcedure;


Define Procedure ReportToASAHeader(String SpaceCraftName, ReportInterface ASATrackingData);
	Report "#   Ephemerides" to ASATrackingData without headers without pad;
	Report "#   -----------" to ASATrackingData without headers without pad;
	Report "#   Created    : ", SystemTime().ConvertToCalendarDate()  to ASATrackingData without headers without pad;
	Report "#" to ASATrackingData without headers without pad;
	Report "#   Object     : ", SpaceCraftName to ASATrackingData without headers without pad;              
	Report "#" to ASATrackingData without headers without pad;
	//Report "#   (topocentric, True aquator And equinox; VRA Is sky motion Not coordinate motion, i.e. w/o cos(DEC))" to ASATrackingData without headers without pad;
	//Report "#" to ASATrackingData without headers without pad;
	//Report "#	Note that RA/DE are in ICRF frame, not TETE as telescope expects" to ASATrackingData without headers without pad;
	//Report "#" to ASATrackingData without headers without pad;
	//Report "#" to ASATrackingData without headers without pad;
	Report "#" to ASATrackingData without headers without pad;
	Report "#   Epoch          RA           DE           VRA       VDE      AZI         ELE" to ASATrackingData without headers without pad;
	Report "#    mjd           rad          rad             arcs/sec        deg         deg" to ASATrackingData without headers without pad;
	Report "#" to ASATrackingData without headers without pad;
EndProcedure;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="false">
        <Label>Console Setup</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Console Setup
Console.DockMode = 3;
Console.Dimension = 40;
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Lime;
Console.WordWrap = 1;
Console.Show();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Python Input and name-adaption</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// define 
FF_SolarSystem.DefaultEarthOrientationParametersFile = "./Support_Files/earth_orientation_parameters_celestrak.csv";

TimeSpan watchWindow_Timespan; // = TIMESPAN(90 minutes);
String startTime_String; // = "Jan 17 2026 14:36:00";
String SpaceCraftName; // = "STARLINK-2052";

ApiLabel "Python-Input";

/* ######## Remove file corrputing characters and define files (eph + tle) ######## */
String asa_tracking_name = SpaceCraftName.Replace(" ", "-");
asa_tracking_name = asa_tracking_name.Replace("/", "-");
asa_tracking_name = asa_tracking_name.Replace("\", "-");
asa_tracking_name = asa_tracking_name.Replace("<", "-");
asa_tracking_name = asa_tracking_name.Replace(">", "-");
asa_tracking_name = asa_tracking_name.Replace(":", "-");
asa_tracking_name = asa_tracking_name.Replace("*", "-");
asa_tracking_name = asa_tracking_name.Replace("?", "-");
asa_tracking_name = asa_tracking_name.Replace('"', "-");

ReportInterface GSO_tracking_data("tmp/ASATrackingData_OD_"+asa_tracking_name+".eph");
Call ReportToASAHeader(SpaceCraftName,GSO_tracking_data);

String OD_samples_file = "./tmp/pseudo_pointobservations_"+asa_tracking_name+"_blackjack.txt";]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup SpaceCraft</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// ######## OD spacecraft setup ########
TwoLineElement spacecraftTLE;
String TLEFile = "TLE_export.tle";
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(OD_sc);
spacecraftTLE.WriteToFile(1, "tmp/ASATrackingData_"+asa_tracking_name+".tle"); // export TLE of spacecraft as well
// configure with nice numerical propagator
String targetProp = "RK89";
OD_sc.SetPropagatorType(targetProp);
OD_sc.Propagator.StepSize = TIMESPAN(10 seconds);

(OD_sc.Propagator AsType RK89).ForceModel.PlanetFieldDegree = {0,0,50,0,0,0,0,0,0,0,0};
(OD_sc.Propagator AsType RK89).ForceModel.PlanetFieldOrder = {0,0,50,0,0,0,0,0,0,0,0};
(OD_sc.Propagator AsType RK89).ForceModel.Drag = 1;
(OD_sc.Propagator AsType RK89).ForceModel.Lift = 1;
(OD_sc.Propagator AsType RK89).ForceModel.AtmosphericDensityModel = 4;
(OD_sc.Propagator AsType RK89).ForceModel.SRP = 1;


]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup GroundStation</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[MPEI_OGS.Latitude = 48.181927150599996;
MPEI_OGS.Longitude = 16.396529607155557;
MPEI_OGS.Height = 0.2425827;
MPEI_OGS.ConeElevation = 20;]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup OD</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[BatchLeastSquaresOD BatchOD1;
BatchOD1.AprioriCovarianceOption = 1;
BatchOD1.MeasurementEditingOption = 2; // necessary to use all measurements!
BatchOD1.MaxAllowableSigma = 6; // has no effect with above setting
BatchOD1.SolutionEpochOption = 0;
BatchOD1.SolutionDampingOption = 0;

// Spacecraft OD Setup
// Properties to Estimate
OD_sc.OD.Cartesian.PositionProcessAction = 1;
OD_sc.OD.Cartesian.VelocityProcessAction = 1;
OD_sc.OD.Cartesian.Position[0].Sigma = 0.5;
OD_sc.OD.Cartesian.Position[1].Sigma = 0.5;
OD_sc.OD.Cartesian.Position[2].Sigma = 0.5;

OD_sc.OD.Cartesian.Velocity[0].Sigma = 0.005;
OD_sc.OD.Cartesian.Velocity[1].Sigma = 0.005;
OD_sc.OD.Cartesian.Velocity[2].Sigma = 0.005;

// Properties to Ignore
OD_sc.OD.Cd.ProcessAction = 0; // setting 2 makes more problems than it helps
OD_sc.OD.Cr.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsX.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsY.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsZ.ProcessAction = 0;



// spacecraft receiver OD Setup
Alias receiver = OD_sc.GNSSReceivers[0]; // This alias is used to shorten the script
// Point Solution Observation Receiver Properties
receiver.OD.PointSolutionObservation.TimeTagBias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.X.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.Y.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.Z.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.VX.Bias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.VY.Bias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.VZ.Bias.ProcessAction  = 0;


// Connect SpaceCraft to BatchOD1
BatchOD1.AddObjectToProcess(OD_sc);]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup OD Observation</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Make Observation
BlackJackPointSolutionFile BlackJackObservationsFile1;
BlackJackObservationsFile1.Filename = OD_samples_file;
BlackJackObservationsFile1.SetMeasuringReceiver(OD_sc.GNSSReceivers[0]);
BlackJackObservationsFile1.UseX = 1;
BlackJackObservationsFile1.UseY = 1;
BlackJackObservationsFile1.UseZ = 1;
BlackJackObservationsFile1.UseVX = 1;
BlackJackObservationsFile1.UseVY = 1;
BlackJackObservationsFile1.UseVZ = 1;

// Add the observation file to the Batch
BatchOD1.RegisterTrackingDataFile(BlackJackObservationsFile1);

// Initialize the BatchLeastSquaresOD object's Observations array with the observations within BlackJackObservationsFile1
BatchOD1.LoadObservationData();
]]></FreeFormScript>
      </FreeForm>
      <ReportCommand enabled="false">
        <Report name="Command8" isConstant="false" isGlobal="false">
          <Name>Command8</Name>
          <OutputType>ConsoleWindow</OutputType>
          <OutputTypes>
            <ConsoleWindow>
              <ConsoleWindow>Console</ConsoleWindow>
            </ConsoleWindow>
          </OutputTypes>
          <Items dim="1">
            <value>
              <StringConstant name="Command8_:BaseObject" isConstant="false" isGlobal="false">
                <Name>Command8_:BaseObject</Name>
                <value>FInished Setup</value>
                <metadata dim="0" />
              </StringConstant>
            </value>
          </Items>
          <WithoutHeaders>false</WithoutHeaders>
          <WithoutLinefeed>false</WithoutLinefeed>
          <WithoutPad>false</WithoutPad>
          <metadata dim="0" />
        </Report>
      </ReportCommand>
      <FreeForm enabled="true">
        <Label>Iterate the Batch</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Iterate the Batch

Variable batch_pos_change;
Variable batch_vel_change;

Array last_position[3];
last_position = OD_sc.Position;

Array last_velocity[3];
last_velocity = OD_sc.Velocity;

batch_pos_change = last_position.Norm();
batch_vel_change = last_velocity.Norm();
While ((batch_pos_change > 0.00001) or (batch_vel_change > 0.00001));
	BatchOD1.Iterate();
	BatchIterationCount++;
//	Report "Itertion count is:" to Console;
//	Report BatchIterationCount to Console;
//	
//	Update StateReport;
	
	// calculate batch update
	batch_pos_change = (OD_sc.Position - last_position).Norm();
	batch_vel_change = (OD_sc.Velocity - last_velocity).Norm();
//	Report "Pos and Vel change are:" to Console;
//	Report batch_pos_change, batch_vel_change to Console;
	
	// store current position & velocity for next update
	last_position = OD_sc.Position;
	last_velocity = OD_sc.Velocity;
	ApiLabel "Iteration-Finished";
End;


ApiLabel "All-Iterations-Finished";

]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Step Spacecraft to Watch Window</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// variables startTime_String and watchWindow_Timespan are set via Python in (#2)

TimeSpan StartTime = startTime_String.ParseCalendarDate();
Step OD_sc to (OD_sc.Epoch == StartTime);
OD_sc.Propagator.StepSize = TIMESPAN(3 seconds); // ab jetzt feiner auflösen um mehr samples während Überflug zu haben]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup Observation objects and Noise/Bias</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[/* ######## Define List for observatuons/measurements ######## */
List<GroundStationObservation> GroundStationObservations;
// FFGroundObservationFile FFGroundObservationFile1;

MPEI_OGS.Antenna.OD.GroundObservation.Elevation.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Elevation.Noise = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Azimuth.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Azimuth.Noise = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Range.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Range.Noise = 0;
MPEI_OGS.Antenna.OD.GroundObservation.RangeRate.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.RangeRate.Noise = 0;]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Propagate spacecraft and generate data</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[While (OD_sc.ElapsedTime < watchWindow_Timespan or MPEI_OGS.Elevation(OD_sc) > MPEI_OGS.ConeElevation);
	// report data only while spacecraft is visible from groundstation
	If (MPEI_OGS.Elevation(OD_sc) > MPEI_OGS.ConeElevation);
		// ###### generiere tracking data mit light time corrections und Report to Ephemeris ######
		// Set up another observation
		GroundStationObservations.Count++;
		i = GroundStationObservations.Count - 1;

		// Turn on measurements and corrections
		// note that all possible noises are set to zero!
		GroundStationObservations[i].UseAzimuth   = 1;
		GroundStationObservations[i].UseElevation = 1;
		GroundStationObservations[i].UseRange     = 0;
		GroundStationObservations[i].UseRangeRate = 0;
		GroundStationObservations[i].UseRightAscension = 0;
		GroundStationObservations[i].UseDeclination = 0;
		GroundStationObservations[i].UseIonosphericCorrection  = 0; // needs solar activity data, in LEO rather irrelevant
		GroundStationObservations[i].UseLightTimeCorrection    = 1;
		GroundStationObservations[i].UseTroposphericCorrection = 0; // would apply refraction corrections, telescope does this itself

		GroundStationObservations[i].SetObjectBeingObserved(OD_sc);
		GroundStationObservations[i].SetObserver(MPEI_OGS.Antenna);
		OD_sc.SimulateTrackingData(GroundStationObservations[i]);
		
		Call ReportObservationToASAStructure(OD_sc, GroundStationObservations[i], GSO_tracking_data);
		
//		Update AzimuthPlot;
//		Update ElevationPlot;
	End;
	Step OD_sc;
End;

// Write List of GroundStationObservations to a FF Ground Observation output file
// FFGroundObservationFile1.WriteValidDataToFile("tmp/FFGroundObservations_"+asa_tracking_name+".txt", GroundStationObservations);]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[Define Procedure ReportObservationToASAStructure(Spacecraft sc, GroundStationObservation gso, ReportInterface ASATrackingData);
	Variable mjdUTC = sc.EpochUTC.ToDays + 29999.5; // spacecraft default ref:1941 to asa ref: 1858
	Variable elevation = gso.Elevation.ObservedValue * 180 / Constants.Pi;
	Variable azimuth = gso.Azimuth.ObservedValue * 180 / Constants.Pi;
	Variable RA = 0.0; //(sc.RA / 180) * Constants.Pi; // not light time corrected!
	Variable DE = 0.0; //(sc.DEC / 180) * Constants.Pi; // not light time corrected!
	Variable emptyVar = 0.0;
	Report mjdUTC.Format("%14.8f"), " ", RA.Format("%12.9f"),DE.Format("%13.9f"),"  000.0000  000.0000", azimuth.Format("%12.6f"), elevation.Format("%12.6f") to ASATrackingData without headers without pad;
EndProcedure;


Define Procedure ReportToASAHeader(String SpaceCraftName, ReportInterface ASATrackingData);
	Report "#   Ephemerides" to ASATrackingData without headers without pad;
	Report "#   -----------" to ASATrackingData without headers without pad;
	Report "#   Created    : ", SystemTime().ConvertToCalendarDate()  to ASATrackingData without headers without pad;
	Report "#" to ASATrackingData without headers without pad;
	Report "#   Object     : ", SpaceCraftName to ASATrackingData without headers without pad;              
	Report "#" to ASATrackingData without headers without pad;
	//Report "#   (topocentric, True aquator And equinox; VRA Is sky motion Not coordinate motion, i.e. w/o cos(DEC))" to ASATrackingData without headers without pad;
	//Report "#" to ASATrackingData without headers without pad;
	//Report "#	Note that RA/DE are in ICRF frame, not TETE as telescope expects" to ASATrackingData without headers without pad;
	//Report "#" to ASATrackingData without headers without pad;
	//Report "#" to ASATrackingData without headers without pad;
	Report "#" to ASATrackingData without headers without pad;
	Report "#   Epoch          RA           DE           VRA       VDE      AZI         ELE" to ASATrackingData without headers without pad;
	Report "#    mjd           rad          rad             arcs/sec        deg         deg" to ASATrackingData without headers without pad;
	Report "#" to ASATrackingData without headers without pad;
EndProcedure;

// // Console Setup
// Console.DockMode = 3;
// Console.Dimension = 40;
// Console.BackColor = ColorTools.Black;
// Console.CurrentTextColor = ColorTools.Lime;
// Console.WordWrap = 1;
// Console.Show();
// define 
FF_SolarSystem.DefaultEarthOrientationParametersFile = "./Support_Files/earth_orientation_parameters_celestrak.csv";

TimeSpan watchWindow_Timespan; // = TIMESPAN(90 minutes);
String startTime_String; // = "Jan 17 2026 14:36:00";
String SpaceCraftName; // = "STARLINK-2052";

ApiLabel "Python-Input";

/* ######## Remove file corrputing characters and define files (eph + tle) ######## */
String asa_tracking_name = SpaceCraftName.Replace(" ", "-");
asa_tracking_name = asa_tracking_name.Replace("/", "-");
asa_tracking_name = asa_tracking_name.Replace("\", "-");
asa_tracking_name = asa_tracking_name.Replace("<", "-");
asa_tracking_name = asa_tracking_name.Replace(">", "-");
asa_tracking_name = asa_tracking_name.Replace(":", "-");
asa_tracking_name = asa_tracking_name.Replace("*", "-");
asa_tracking_name = asa_tracking_name.Replace("?", "-");
asa_tracking_name = asa_tracking_name.Replace('"', "-");

ReportInterface GSO_tracking_data("tmp/ASATrackingData_OD_"+asa_tracking_name+".eph");
Call ReportToASAHeader(SpaceCraftName,GSO_tracking_data);

String OD_samples_file = "./tmp/pseudo_pointobservations_"+asa_tracking_name+"_blackjack.txt";
// ######## OD spacecraft setup ########
TwoLineElement spacecraftTLE;
String TLEFile = "TLE_export.tle";
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(OD_sc);
spacecraftTLE.WriteToFile(1, "tmp/ASATrackingData_"+asa_tracking_name+".tle"); // export TLE of spacecraft as well
// configure with nice numerical propagator
String targetProp = "RK89";
OD_sc.SetPropagatorType(targetProp);
OD_sc.Propagator.StepSize = TIMESPAN(10 seconds);

(OD_sc.Propagator AsType RK89).ForceModel.PlanetFieldDegree = {0,0,50,0,0,0,0,0,0,0,0};
(OD_sc.Propagator AsType RK89).ForceModel.PlanetFieldOrder = {0,0,50,0,0,0,0,0,0,0,0};
(OD_sc.Propagator AsType RK89).ForceModel.Drag = 1;
(OD_sc.Propagator AsType RK89).ForceModel.Lift = 1;
(OD_sc.Propagator AsType RK89).ForceModel.AtmosphericDensityModel = 4;
(OD_sc.Propagator AsType RK89).ForceModel.SRP = 1;



MPEI_OGS.Latitude = 48.181927150599996;
MPEI_OGS.Longitude = 16.396529607155557;
MPEI_OGS.Height = 0.2425827;
MPEI_OGS.ConeElevation = 20;
BatchLeastSquaresOD BatchOD1;
BatchOD1.AprioriCovarianceOption = 1;
BatchOD1.MeasurementEditingOption = 2; // necessary to use all measurements!
BatchOD1.MaxAllowableSigma = 6; // has no effect with above setting
BatchOD1.SolutionEpochOption = 0;
BatchOD1.SolutionDampingOption = 0;

// Spacecraft OD Setup
// Properties to Estimate
OD_sc.OD.Cartesian.PositionProcessAction = 1;
OD_sc.OD.Cartesian.VelocityProcessAction = 1;
OD_sc.OD.Cartesian.Position[0].Sigma = 0.5;
OD_sc.OD.Cartesian.Position[1].Sigma = 0.5;
OD_sc.OD.Cartesian.Position[2].Sigma = 0.5;

OD_sc.OD.Cartesian.Velocity[0].Sigma = 0.005;
OD_sc.OD.Cartesian.Velocity[1].Sigma = 0.005;
OD_sc.OD.Cartesian.Velocity[2].Sigma = 0.005;

// Properties to Ignore
OD_sc.OD.Cd.ProcessAction = 0; // setting 2 makes more problems than it helps
OD_sc.OD.Cr.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsX.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsY.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsZ.ProcessAction = 0;



// spacecraft receiver OD Setup
Alias receiver = OD_sc.GNSSReceivers[0]; // This alias is used to shorten the script
// Point Solution Observation Receiver Properties
receiver.OD.PointSolutionObservation.TimeTagBias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.X.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.Y.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.Z.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.VX.Bias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.VY.Bias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.VZ.Bias.ProcessAction  = 0;


// Connect SpaceCraft to BatchOD1
BatchOD1.AddObjectToProcess(OD_sc);
// Make Observation
BlackJackPointSolutionFile BlackJackObservationsFile1;
BlackJackObservationsFile1.Filename = OD_samples_file;
BlackJackObservationsFile1.SetMeasuringReceiver(OD_sc.GNSSReceivers[0]);
BlackJackObservationsFile1.UseX = 1;
BlackJackObservationsFile1.UseY = 1;
BlackJackObservationsFile1.UseZ = 1;
BlackJackObservationsFile1.UseVX = 1;
BlackJackObservationsFile1.UseVY = 1;
BlackJackObservationsFile1.UseVZ = 1;

// Add the observation file to the Batch
BatchOD1.RegisterTrackingDataFile(BlackJackObservationsFile1);

// Initialize the BatchLeastSquaresOD object's Observations array with the observations within BlackJackObservationsFile1
BatchOD1.LoadObservationData();

// Report "FInished Setup" to Console;
// Iterate the Batch

Variable batch_pos_change;
Variable batch_vel_change;

Array last_position[3];
last_position = OD_sc.Position;

Array last_velocity[3];
last_velocity = OD_sc.Velocity;

batch_pos_change = last_position.Norm();
batch_vel_change = last_velocity.Norm();
While ((batch_pos_change > 0.00001) or (batch_vel_change > 0.00001));
	BatchOD1.Iterate();
	BatchIterationCount++;
//	Report "Itertion count is:" to Console;
//	Report BatchIterationCount to Console;
//	
//	Update StateReport;
	
	// calculate batch update
	batch_pos_change = (OD_sc.Position - last_position).Norm();
	batch_vel_change = (OD_sc.Velocity - last_velocity).Norm();
//	Report "Pos and Vel change are:" to Console;
//	Report batch_pos_change, batch_vel_change to Console;
	
	// store current position & velocity for next update
	last_position = OD_sc.Position;
	last_velocity = OD_sc.Velocity;
	ApiLabel "Iteration-Finished";
End;


ApiLabel "All-Iterations-Finished";


// variables startTime_String and watchWindow_Timespan are set via Python in (#2)

TimeSpan StartTime = startTime_String.ParseCalendarDate();
Step OD_sc to (OD_sc.Epoch == StartTime);
OD_sc.Propagator.StepSize = TIMESPAN(3 seconds); // ab jetzt feiner auflösen um mehr samples während Überflug zu haben
/* ######## Define List for observatuons/measurements ######## */
List<GroundStationObservation> GroundStationObservations;
// FFGroundObservationFile FFGroundObservationFile1;

MPEI_OGS.Antenna.OD.GroundObservation.Elevation.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Elevation.Noise = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Azimuth.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Azimuth.Noise = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Range.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.Range.Noise = 0;
MPEI_OGS.Antenna.OD.GroundObservation.RangeRate.Bias.Value = 0;
MPEI_OGS.Antenna.OD.GroundObservation.RangeRate.Noise = 0;
While (OD_sc.ElapsedTime < watchWindow_Timespan or MPEI_OGS.Elevation(OD_sc) > MPEI_OGS.ConeElevation);
	// report data only while spacecraft is visible from groundstation
	If (MPEI_OGS.Elevation(OD_sc) > MPEI_OGS.ConeElevation);
		// ###### generiere tracking data mit light time corrections und Report to Ephemeris ######
		// Set up another observation
		GroundStationObservations.Count++;
		i = GroundStationObservations.Count - 1;

		// Turn on measurements and corrections
		// note that all possible noises are set to zero!
		GroundStationObservations[i].UseAzimuth   = 1;
		GroundStationObservations[i].UseElevation = 1;
		GroundStationObservations[i].UseRange     = 0;
		GroundStationObservations[i].UseRangeRate = 0;
		GroundStationObservations[i].UseRightAscension = 0;
		GroundStationObservations[i].UseDeclination = 0;
		GroundStationObservations[i].UseIonosphericCorrection  = 0; // needs solar activity data, in LEO rather irrelevant
		GroundStationObservations[i].UseLightTimeCorrection    = 1;
		GroundStationObservations[i].UseTroposphericCorrection = 0; // would apply refraction corrections, telescope does this itself

		GroundStationObservations[i].SetObjectBeingObserved(OD_sc);
		GroundStationObservations[i].SetObserver(MPEI_OGS.Antenna);
		OD_sc.SimulateTrackingData(GroundStationObservations[i]);
		
		Call ReportObservationToASAStructure(OD_sc, GroundStationObservations[i], GSO_tracking_data);
		
//		Update AzimuthPlot;
//		Update ElevationPlot;
	End;
	Step OD_sc;
End;

// Write List of GroundStationObservations to a FF Ground Observation output file
// FFGroundObservationFile1.WriteValidDataToFile("tmp/FFGroundObservations_"+asa_tracking_name+".txt", GroundStationObservations);]]></ProjectScript>
