  <ProjectMissionSequence>
    <ProjectExternals />
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Define BlackJackFile Procedure</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[Define Procedure ReportPSOObservationToBlackJackStructure(Spacecraft sc, ReportInterface blackJackTrackingData);
	TimeSpan modified_epoch = TimeTools.ConvertTime(sc.Epoch, "UTC", "MJD GSFC", "GPS", "MJD GSFC"); // adds necessary 18 seconds to compensate calender conversion tai -> utc
	String timeString = modified_epoch.ConvertToCalendarDate("YYYY MM DD hh mm ss.ss");
	Array stateInEarthFixedFrame[6];
	stateInEarthFixedFrame = PositionVelocityConvert(1, 4, sc.Epoch, {sc.Position, sc.Velocity});
	Report "0", 
	stateInEarthFixedFrame[0].Format("%13.5f"), 
	stateInEarthFixedFrame[1].Format("%13.5f"), 
	stateInEarthFixedFrame[2].Format("%13.5f"), 
	stateInEarthFixedFrame[3].Format("%12.7f"),	
	stateInEarthFixedFrame[4].Format("%12.7f"), 
	stateInEarthFixedFrame[5].Format("%12.7f"), 
	" ", 
	timeString to blackJackTrackingData without headers without pad;
EndProcedure;]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Variable definitions</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[/* ######## Define all varibales as its not allowed in loops ######## */

/* ######## TLE & Spacecraft setup ######## */
String SpaceCraftName;
TwoLineElement spacecraftTLE;
String TLEFile = "TLE_export.tle";
SGP4 PropagatorSPG4;
Spacecraft1.SetPropagatorType(TypeOf(SGP4)); //change default prpagator to SGP4 for orbit
Spacecraft1.Propagator.StepSize = TIMESPAN(20 seconds); // must be same as formation!!

/* ######## Variables ######## */
Variable T; // orbit duration
TimeSpan four_orbits_duration; // will be 4*T
TimeSpan two_orbits_duration; // will be 2*T
TimeSpan tle_epoch;
TimeSpan while_duration;

/* ######## BlackJack-like output file ######## */
String asa_tracking_name;
String PSO_pseudo_blackjack_file_name;
ReportInterface PSO_pseudo_data("empty.txt");








]]></FreeFormScript>
      </FreeForm>
      <ForCommand enabled="true" collapsed="false" StartLineComment="Loop for each spacecraft">
        <For name="Command3" isConstant="false" isGlobal="false">
          <Name>Command3</Name>
          <Variable>
            <ObjectHolder name="Command3_:Variable" isConstant="false" isGlobal="false">
              <Name>Command3_:Variable</Name>
              <BaseObject>i</BaseObject>
              <metadata dim="0" />
            </ObjectHolder>
          </Variable>
          <InitialValue>
            <DoubleConstant name="Command3_:InitialValue" isConstant="false" isGlobal="false">
              <Name>Command3_:InitialValue</Name>
              <value units="" displayed_units="">0</value>
              <metadata dim="0" />
            </DoubleConstant>
          </InitialValue>
          <MaximumValue>
            <DoubleConstant name="Command3_:MaximumValue" isConstant="false" isGlobal="false">
              <Name>Command3_:MaximumValue</Name>
              <value units="" displayed_units="">7</value>
              <metadata dim="0" />
            </DoubleConstant>
          </MaximumValue>
          <Increment>
            <DoubleConstant name="Command3_:Increment" isConstant="false" isGlobal="false">
              <Name>Command3_:Increment</Name>
              <value units="" displayed_units="">1</value>
              <metadata dim="0" />
            </DoubleConstant>
          </Increment>
          <metadata dim="0" />
        </For>
        <FreeForm enabled="true">
          <Label>spacecraft decision and tracking-name setup</Label>
          <Bookmarks />
          <Breakpoints />
          <FreeFormScript><![CDATA[If (i == 0);
// ######## STELLA ########
SpaceCraftName = "STELLA";
ElseIf (i == 1);
// ######## STARLETTE ########
SpaceCraftName = "STARLETTE";
ElseIf (i == 2);
// ######## LAGEOS 1 ########
SpaceCraftName = "LAGEOS 1";
ElseIf (i == 3);
// ######## LARETS ########
SpaceCraftName = "LARETS";
ElseIf (i == 4);
// ######## LARES ########
SpaceCraftName = "LARES";
ElseIf (i == 5);
// ######## AJISAI (EGS) ########
SpaceCraftName = "AJISAI (EGS)";
ElseIf (i == 6);
// ######## COSMOS 1989 (ETALON 1) ########
SpaceCraftName = "COSMOS 1989 (ETALON 1)";
Else;
// ######## COSMOS 2024 (ETALON 2) ########
SpaceCraftName = "COSMOS 2024 (ETALON 2)";
End;

/* ######## BlackJack-like output file ######## */
asa_tracking_name = SpaceCraftName.Replace(" ", "-");
asa_tracking_name = asa_tracking_name.Replace("/", "-");
asa_tracking_name = asa_tracking_name.Replace("\", "-");
asa_tracking_name = asa_tracking_name.Replace("<", "-");
asa_tracking_name = asa_tracking_name.Replace(">", "-");
asa_tracking_name = asa_tracking_name.Replace(":", "-");
asa_tracking_name = asa_tracking_name.Replace("*", "-");
asa_tracking_name = asa_tracking_name.Replace("?", "-");
asa_tracking_name = asa_tracking_name.Replace('"', "-");]]></FreeFormScript>
        </FreeForm>
        <ForCommand enabled="true" collapsed="false" StartLineComment="Loop for each while-duration">
          <For name="Command5" isConstant="false" isGlobal="false">
            <Name>Command5</Name>
            <Variable>
              <ObjectHolder name="Command5_:Variable" isConstant="false" isGlobal="false">
                <Name>Command5_:Variable</Name>
                <BaseObject>j</BaseObject>
                <metadata dim="0" />
              </ObjectHolder>
            </Variable>
            <InitialValue>
              <DoubleConstant name="Command5_:InitialValue" isConstant="false" isGlobal="false">
                <Name>Command5_:InitialValue</Name>
                <value units="" displayed_units="">0</value>
                <metadata dim="0" />
              </DoubleConstant>
            </InitialValue>
            <MaximumValue>
              <DoubleConstant name="Command5_:MaximumValue" isConstant="false" isGlobal="false">
                <Name>Command5_:MaximumValue</Name>
                <value units="" displayed_units="">4</value>
                <metadata dim="0" />
              </DoubleConstant>
            </MaximumValue>
            <Increment>
              <DoubleConstant name="Command5_:Increment" isConstant="false" isGlobal="false">
                <Name>Command5_:Increment</Name>
                <value units="" displayed_units="">1</value>
                <metadata dim="0" />
              </DoubleConstant>
            </Increment>
            <metadata dim="0" />
          </For>
          <FreeForm enabled="true">
            <Label>Setup SpaceCraft and Variables</Label>
            <Bookmarks />
            <Breakpoints />
            <FreeFormScript><![CDATA[/* ######## TLE & Spacecraft setup ######## */
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(Spacecraft1);
Report Spacecraft1.Epoch;


/* ######## Set Variables ######## */
T = 2*Constants.Pi/Spacecraft1.MeanMotion; // orbit duration
two_orbits_duration = TimeSpan.FromSeconds(2*T);
four_orbits_duration = TimeSpan.FromSeconds(4*T);
tle_epoch = Spacecraft1.Epoch;






]]></FreeFormScript>
          </FreeForm>
          <FreeForm enabled="true">
            <Label>Setup Output-FIle and Report interface</Label>
            <Bookmarks />
            <Breakpoints />
            <FreeFormScript><![CDATA[If (j==0);
	/* ######## 2 orbits ######## */
	while_duration = tle_epoch + two_orbits_duration;
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_2T_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
ElseIf (j==1);
	/* ######## 4 orbits ######## */
	while_duration = tle_epoch + four_orbits_duration;
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_4T_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
ElseIf (j==2);
	/* ######## 1 day ######## */
	while_duration = tle_epoch + TIMESPAN(1 days);
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_1d_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
ElseIf (j==3);
	/* ######## 2 days ######## */
	while_duration = tle_epoch + TIMESPAN(2 days);
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_2d_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
Else;
	/* ######## 3 days ######## */
	while_duration = tle_epoch + TIMESPAN(3 days);
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_3d_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
End;



]]></FreeFormScript>
          </FreeForm>
          <FreeForm enabled="true" comment=" ">
            <Label>Propagate and pseudo observations</Label>
            <Bookmarks />
            <Breakpoints />
            <FreeFormScript><![CDATA[While (Spacecraft1.Epoch <= while_duration);
	View Spacecraft1;
	// ###### generiere tracking data ###### 
	Call ReportPSOObservationToBlackJackStructure(Spacecraft1, PSO_pseudo_data);
	Step Spacecraft1;
End;]]></FreeFormScript>
          </FreeForm>
        </ForCommand>
      </ForCommand>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[Define Procedure ReportPSOObservationToBlackJackStructure(Spacecraft sc, ReportInterface blackJackTrackingData);
	TimeSpan modified_epoch = TimeTools.ConvertTime(sc.Epoch, "UTC", "MJD GSFC", "GPS", "MJD GSFC"); // adds necessary 18 seconds to compensate calender conversion tai -> utc
	String timeString = modified_epoch.ConvertToCalendarDate("YYYY MM DD hh mm ss.ss");
	Array stateInEarthFixedFrame[6];
	stateInEarthFixedFrame = PositionVelocityConvert(1, 4, sc.Epoch, {sc.Position, sc.Velocity});
	Report "0", 
	stateInEarthFixedFrame[0].Format("%13.5f"), 
	stateInEarthFixedFrame[1].Format("%13.5f"), 
	stateInEarthFixedFrame[2].Format("%13.5f"), 
	stateInEarthFixedFrame[3].Format("%12.7f"),	
	stateInEarthFixedFrame[4].Format("%12.7f"), 
	stateInEarthFixedFrame[5].Format("%12.7f"), 
	" ", 
	timeString to blackJackTrackingData without headers without pad;
EndProcedure;
/* ######## Define all varibales as its not allowed in loops ######## */

/* ######## TLE & Spacecraft setup ######## */
String SpaceCraftName;
TwoLineElement spacecraftTLE;
String TLEFile = "TLE_export.tle";
SGP4 PropagatorSPG4;
Spacecraft1.SetPropagatorType(TypeOf(SGP4)); //change default prpagator to SGP4 for orbit
Spacecraft1.Propagator.StepSize = TIMESPAN(20 seconds); // must be same as formation!!

/* ######## Variables ######## */
Variable T; // orbit duration
TimeSpan four_orbits_duration; // will be 4*T
TimeSpan two_orbits_duration; // will be 2*T
TimeSpan tle_epoch;
TimeSpan while_duration;

/* ######## BlackJack-like output file ######## */
String asa_tracking_name;
String PSO_pseudo_blackjack_file_name;
ReportInterface PSO_pseudo_data("empty.txt");









For i = 0 to 7 step 1;
If (i == 0);
// ######## STELLA ########
SpaceCraftName = "STELLA";
ElseIf (i == 1);
// ######## STARLETTE ########
SpaceCraftName = "STARLETTE";
ElseIf (i == 2);
// ######## LAGEOS 1 ########
SpaceCraftName = "LAGEOS 1";
ElseIf (i == 3);
// ######## LARETS ########
SpaceCraftName = "LARETS";
ElseIf (i == 4);
// ######## LARES ########
SpaceCraftName = "LARES";
ElseIf (i == 5);
// ######## AJISAI (EGS) ########
SpaceCraftName = "AJISAI (EGS)";
ElseIf (i == 6);
// ######## COSMOS 1989 (ETALON 1) ########
SpaceCraftName = "COSMOS 1989 (ETALON 1)";
Else;
// ######## COSMOS 2024 (ETALON 2) ########
SpaceCraftName = "COSMOS 2024 (ETALON 2)";
End;

/* ######## BlackJack-like output file ######## */
asa_tracking_name = SpaceCraftName.Replace(" ", "-");
asa_tracking_name = asa_tracking_name.Replace("/", "-");
asa_tracking_name = asa_tracking_name.Replace("\", "-");
asa_tracking_name = asa_tracking_name.Replace("<", "-");
asa_tracking_name = asa_tracking_name.Replace(">", "-");
asa_tracking_name = asa_tracking_name.Replace(":", "-");
asa_tracking_name = asa_tracking_name.Replace("*", "-");
asa_tracking_name = asa_tracking_name.Replace("?", "-");
asa_tracking_name = asa_tracking_name.Replace('"', "-");
For j = 0 to 4 step 1;
/* ######## TLE & Spacecraft setup ######## */
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(Spacecraft1);
Report Spacecraft1.Epoch;


/* ######## Set Variables ######## */
T = 2*Constants.Pi/Spacecraft1.MeanMotion; // orbit duration
two_orbits_duration = TimeSpan.FromSeconds(2*T);
four_orbits_duration = TimeSpan.FromSeconds(4*T);
tle_epoch = Spacecraft1.Epoch;







If (j==0);
	/* ######## 2 orbits ######## */
	while_duration = tle_epoch + two_orbits_duration;
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_2T_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
ElseIf (j==1);
	/* ######## 4 orbits ######## */
	while_duration = tle_epoch + four_orbits_duration;
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_4T_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
ElseIf (j==2);
	/* ######## 1 day ######## */
	while_duration = tle_epoch + TIMESPAN(1 days);
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_1d_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
ElseIf (j==3);
	/* ######## 2 days ######## */
	while_duration = tle_epoch + TIMESPAN(2 days);
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_2d_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
Else;
	/* ######## 3 days ######## */
	while_duration = tle_epoch + TIMESPAN(3 days);
	Close PSO_pseudo_data;
	PSO_pseudo_blackjack_file_name = "observation_data/pseudo_pointobservations_3d_"+asa_tracking_name+"_blackjack.txt";
	PSO_pseudo_data.Filename= PSO_pseudo_blackjack_file_name;
	PSO_pseudo_data.Append = 0;
End;




While (Spacecraft1.Epoch <= while_duration);
	View Spacecraft1;
	// ###### generiere tracking data ###### 
	Call ReportPSOObservationToBlackJackStructure(Spacecraft1, PSO_pseudo_data);
	Step Spacecraft1;
End;
End;
End;]]></ProjectScript>
  <ProjectNotes></ProjectNotes>
</FreeFlyerProjectFile>