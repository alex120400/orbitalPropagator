      <FreeForm enabled="true">
        <Label>console setup</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Console Setup
Console.DockMode = 3;
Console.Dimension = 40;
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Lime;
Console.WordWrap = 1;
Console.Show();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup SpaceCrafts</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// define 
FF_SolarSystem.DefaultEarthOrientationParametersFile = "../Support_Files/earth_orientation_parameters_celestrak.csv";

String SpaceCraftName = "STELLA";
String OD_samples_file = "./observation_data/pseudo_pointobservations_3d_STELLA_blackjack.txt";
String ID = "3d";
Report SpaceCraftName, ID to Console;
ApiLabel "Python-Input";

String truth_FFephem_file;
If (SpaceCraftName == "STELLA");
	truth_FFephem_file = "./ephemeris/stella.FFEphem";
	
ElseIf (SpaceCraftName == "STARLETTE");
	truth_FFephem_file = "./ephemeris/starlette.FFEphem";
	
ElseIf (SpaceCraftName == "LAGEOS-1");
	truth_FFephem_file = "./ephemeris/lageos-1.FFEphem";
	
ElseIf (SpaceCraftName == "STARLETTE");
	truth_FFephem_file = "./ephemeris/starlette.FFEphem";
	
ElseIf (SpaceCraftName == "COSMOS-2024-(ETALON-2)");	
	truth_FFephem_file = "./ephemeris/cosmos-2024-(etalon-2).FFEphem";
	
ElseIf (SpaceCraftName == "COSMOS-1989-(ETALON-1)");	
	truth_FFephem_file = "./ephemeris/cosmos-1989-(etalon-1).FFEphem";
	
ElseIf (SpaceCraftName == "AJISAI-(EGS)");	
	truth_FFephem_file = "./ephemeris/ajisai-(EGS).FFEphem";
	
ElseIf (SpaceCraftName == "LARES");	
	truth_FFephem_file = "./ephemeris/lares.FFEphem";
	
ElseIf (SpaceCraftName == "LARETS");	
	truth_FFephem_file = "./ephemeris/larets.FFEphem";
	
Else;
	truth_FFephem_file = "spacecrafte name not found";
End;

//// ######## STELLA ########
// SpaceCraftName = "STELLA";
//Report "STELLA" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_STELLA_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_STELLA_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_STELLA_blackjack.txt";
//Report "1d pseudo sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_STELLA_blackjack.txt";
//Report "2d pseudo sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_STELLA_blackjack.txt";
//Report "3d pseudo sample" to Console;
// truth_FFephem_file = "./ephemeris/stella.FFEphem";
//
//// ######## STARLETTE ########
// SpaceCraftName = "STARLETTE";
//Report "STARLETTE" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_STARLETTE_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_STARLETTE_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_STARLETTE_blackjack.txt";
//Report "1d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_STARLETTE_blackjack.txt";
//Report "2d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_STARLETTE_blackjack.txt";
//Report "3d sample" to Console;
// truth_FFephem_file = "./ephemeris/starlette.FFEphem";
//
//// ######## LAGEOS 1 ########
// SpaceCraftName = "LAGEOS 1";
//Report "LAGEOS 1" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_LAGEOS-1_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_LAGEOS-1_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_LAGEOS-1_blackjack.txt";
//Report "1d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_LAGEOS-1_blackjack.txt";
//Report "2d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_LAGEOS-1_blackjack.txt";
//Report "3d sample" to Console;
// truth_FFephem_file = "./ephemeris/lageos-1.FFEphem";
//
//// ######## LARETS ########
// SpaceCraftName = "LARETS";
//Report "LARETS" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_LARETS_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_LARETS_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_LARETS_blackjack.txt";
//Report "1d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_LARETS_blackjack.txt";
//Report "2d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_LARETS_blackjack.txt";
//Report "3d sample" to Console;
// truth_FFephem_file = "./ephemeris/larets.FFEphem";
//
//// ######## LARES ########
// SpaceCraftName = "LARES";
//Report "LARES" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_LARES_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_LARES_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_LARES_blackjack.txt";
//Report "1d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_LARES_blackjack.txt";
//Report "2d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_LARES_blackjack.txt";
//Report "3d sample" to Console;
// truth_FFephem_file = "./ephemeris/lares.FFEphem";

//
//// ######## AJISAI (EGS) ########
// SpaceCraftName = "AJISAI (EGS)";
// Report "AJISAI" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_AJISAI-(EGS)_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_AJISAI-(EGS)_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_AJISAI-(EGS)_blackjack.txt";
//Report "1d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_AJISAI-(EGS)_blackjack.txt";
//Report "2d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_AJISAI-(EGS)_blackjack.txt";
//Report "3d sample" to Console;
// truth_FFephem_file = "./ephemeris/ajisai-(EGS).FFEphem";
	
//
//// ######## COSMOS 1989 (ETALON 1) ########
// SpaceCraftName = "COSMOS 1989 (ETALON 1)";
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_COSMOS-1989-(ETALON-1)_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_COSMOS-1989-(ETALON-1)_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_COSMOS-1989-(ETALON-1)_blackjack.txt";
//Report "1d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_COSMOS-1989-(ETALON-1)_blackjack.txt";
//Report "2d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_COSMOS-1989-(ETALON-1)_blackjack.txt";
//Report "3d sample" to Console;
// truth_FFephem_file = "./ephemeris/cosmos-1989-(etalon-1).FFEphem";
	
//
//// ######## COSMOS 2024 (ETALON 2) ########
// SpaceCraftName = "COSMOS 2024 (ETALON 2)";
// OD_samples_file = "./observation_data/pseudo_pointobservations_2T_COSMOS-2024-(ETALON-2)_blackjack.txt";
//Report "2T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_4T_COSMOS-2024-(ETALON-2)_blackjack.txt";
//Report "4T sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_1d_COSMOS-2024-(ETALON-2)_blackjack.txt";
//Report "1d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_2d_COSMOS-2024-(ETALON-2)_blackjack.txt";
//Report "2d sample" to Console;
// OD_samples_file = "./observation_data/pseudo_pointobservations_3d_COSMOS-2024-(ETALON-2)_blackjack.txt";
//Report "3d sample" to Console;
// truth_FFephem_file = "./ephemeris/cosmos-2024-(etalon-2).FFEphem";
	
 
 
//If (FileSystem.Exists(".\\pos_error_data\\" + SpaceCraftName) != 1);
//	FileSystem.CreateDirectory(".\\pos_error_data\\" + SpaceCraftName);
//End;


// ######## TLE spacecraft setup ########
TwoLineElement spacecraftTLE;
String TLEFile = "TLE_export.tle";
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(TLE_sc);
TLE_sc.SetPropagatorType(TypeOf(SGP4));
TLE_sc.Propagator.StepSize = TIMESPAN(10 seconds);
TLE_sc.DisplayName = "TLE sc";

Report "Initial Epoch and state of TLE:" to Console;
Report TLE_sc.Epoch to Console;
Report TLE_sc.Position, TLE_sc.Velocity to Console;
Step TLE_sc;
Report "After 10 sec step is epoch and state of TLE:" to Console;
Report TLE_sc.Epoch to Console;
Report TLE_sc.Position, TLE_sc.Velocity to Console;


// ######## OD spacecraft setup ########
spacecraftTLE.LoadTLE(TLEFile, SpaceCraftName);
spacecraftTLE.SetSpacecraftStateFromTLE(OD_sc);
OD_sc.DisplayName = "OD sc";
Report "Apriori epoch and state of OD:" to Console;
Report OD_sc.Epoch to Console;
Report OD_sc.Position, OD_sc.Velocity to Console;

// configure with nice numerical propagator
String targetProp = "RK89";
OD_sc.SetPropagatorType(targetProp);
OD_sc.Propagator.StepSize = TIMESPAN(10 seconds);

(OD_sc.Propagator AsType RK89).ForceModel.PlanetFieldDegree = {0,0,50,0,0,0,0,0,0,0,0};
(OD_sc.Propagator AsType RK89).ForceModel.PlanetFieldOrder = {0,0,50,0,0,0,0,0,0,0,0};
(OD_sc.Propagator AsType RK89).ForceModel.Drag = 1;
(OD_sc.Propagator AsType RK89).ForceModel.Lift = 1;
(OD_sc.Propagator AsType RK89).ForceModel.AtmosphericDensityModel = 4;
(OD_sc.Propagator AsType RK89).ForceModel.SRP = 1;

BatchRMSPlot.PointsToUpdate    = 1;
StateUpdatePlot.PointsToUpdate = 1;



// ######## Truth spacecraft setup ########
//Ephemeris truth_ephemeris;
truth_ephemeris.LoadEphemeris(truth_FFephem_file);
Truth_sc.Epoch = truth_ephemeris.StartEpoch;
Truth_sc.DisplayName = "Truth sc";

//Truth_sc.SetPropagatorType(TypeOf(Ephemeris));
Truth_sc.Propagator.StepSize = TIMESPAN(10 seconds);
// Alias eph = (Truth_sc.Propagator AsType Ephemeris);
// eph.InterpolationMethod = 1; // 8th Order Lagrange
// eph.FFEphemProperties.FormatVersion = 3;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup GroundStation</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[MPEI_OGS.Latitude = 48.181927150599996;
MPEI_OGS.Longitude = 16.396529607155557;
MPEI_OGS.Height = 0.2425827;
MPEI_OGS.ConeElevation = 20;]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup OD</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[BatchLeastSquaresOD BatchOD1;
BatchOD1.AprioriCovarianceOption = 1;
BatchOD1.MeasurementEditingOption = 2; // necessary to use all measurements!
BatchOD1.MaxAllowableSigma = 6; // has no effect with above setting
BatchOD1.SolutionEpochOption = 0;
BatchOD1.SolutionDampingOption = 0;

// Spacecraft OD Setup
// Properties to Estimate
OD_sc.OD.Cartesian.PositionProcessAction = 1;
OD_sc.OD.Cartesian.VelocityProcessAction = 1;
OD_sc.OD.Cartesian.Position[0].Sigma = 0.5;
OD_sc.OD.Cartesian.Position[1].Sigma = 0.5;
OD_sc.OD.Cartesian.Position[2].Sigma = 0.5;

OD_sc.OD.Cartesian.Velocity[0].Sigma = 0.005;
OD_sc.OD.Cartesian.Velocity[1].Sigma = 0.005;
OD_sc.OD.Cartesian.Velocity[2].Sigma = 0.005;

// Properties to Ignore
OD_sc.OD.Cd.ProcessAction = 0; // setting 2 makes more problems than it helps
OD_sc.OD.Cr.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsX.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsY.ProcessAction = 0;
OD_sc.OD.OtherAccelerationsZ.ProcessAction = 0;



// spacecraft receiver OD Setup
Alias receiver = OD_sc.GNSSReceivers[0]; // This alias is used to shorten the script
// Point Solution Observation Receiver Properties
receiver.OD.PointSolutionObservation.TimeTagBias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.X.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.Y.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.Z.Bias.ProcessAction   = 0;
receiver.OD.PointSolutionObservation.VX.Bias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.VY.Bias.ProcessAction  = 0;
receiver.OD.PointSolutionObservation.VZ.Bias.ProcessAction  = 0;


// Connect SpaceCraft to BatchOD1
BatchOD1.AddObjectToProcess(OD_sc);]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup OD Observation</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Make Observation

BlackJackPointSolutionFile BlackJackObservationsFile1;
BlackJackObservationsFile1.Filename = OD_samples_file;
BlackJackObservationsFile1.SetMeasuringReceiver(OD_sc.GNSSReceivers[0]);
BlackJackObservationsFile1.UseX = 1;
BlackJackObservationsFile1.UseY = 1;
BlackJackObservationsFile1.UseZ = 1;
BlackJackObservationsFile1.UseVX = 1;
BlackJackObservationsFile1.UseVY = 1;
BlackJackObservationsFile1.UseVZ = 1;

// Add the observation file to the Batch
BatchOD1.RegisterTrackingDataFile(BlackJackObservationsFile1);


// Initialize the BatchLeastSquaresOD object's Observations array with the observations within BlackJackObservationsFile1
BatchOD1.LoadObservationData();
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Iterate the Batch</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[StringArray measTypes;
Variable numObs = 0;
Variable i = 0;
// Iterate the Batch

Update StateReport;

For i = 0 to NumIterations-1;
	
	// Send a status report to Console
	Report "Executing Batch Iteration #", (i+1)<1,0> to Console;
	Report "" to Console;

	BatchOD1.Iterate();

	// Generate output reports and plots
	StateUpdate = {OD_sc.OD.Cartesian.X.StateUpdate,  OD_sc.OD.Cartesian.Y.StateUpdate,  OD_sc.OD.Cartesian.Z.StateUpdate, 
	               OD_sc.OD.Cartesian.VX.StateUpdate, OD_sc.OD.Cartesian.VY.StateUpdate, OD_sc.OD.Cartesian.VZ.StateUpdate};

	RMS = BatchOD1.RMS;
	WeightedRMS = BatchOD1.WeightedRMS;
	PredictedRMS = BatchOD1.PredictedRMS;

	BatchIterationCount = BatchOD1.IterationCount;

	Update StateUpdatePlot;
	Update BatchRMSPlot;
	Update StateReport;

End;

]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Evaluate Batch</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[
// Evaluate Solution
BatchOD1.GetPostUpdateResidualStatistics(measTypes, residualMean, residualSigma, residualRMS);
numObs = BatchOD1.Observations.Count;

Report "Epoch after iteratons is:" to Console;
Report OD_sc.Epoch to Console;
// is again epoch like tle


/*
FFGroundObservationFile FFGroundObservationFile2;
FFGroundObservationFile2.Filename = "FFGroundObservationSampleData_second_half.txt";
FFGroundObservationFile2.SetObservedSpacecraft(Spacecraft1);
FFGroundObservationFile2.AddObservationSource(MPEI_OGS);

List<GroundStationObservation> GSObs2;
