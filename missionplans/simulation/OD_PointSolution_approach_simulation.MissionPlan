// OD_sc now has the updated state
// spacecraft already configured with correct propagator
Report "OD SC has propagator and its epoch is: " to Console;
Report OD_sc.PropagatorType to Console;
Report OD_sc.Epoch to Console;

Report "TLE SC has propagator and its epoch is: " to Console;
Report TLE_sc.PropagatorType to Console;
Report TLE_sc.Epoch to Console;
Step TLE_sc to (TLE_sc.Epoch == OD_sc.Epoch);
Report "Now is, plus state:" to Console;
Report TLE_sc.Epoch to Console;
Report TLE_sc.Position, TLE_sc.Velocity to Console;

Report "Truth SC has propagator and its epoch was: " to Console;
Report Truth_sc.PropagatorType to Console;
Report Truth_sc.Epoch to Console;
// Step Truth_sc to (Truth_sc.Epoch == OD_sc.Epoch); // not good here, assign it rather and get position in loop step
Truth_sc.Epoch = OD_sc.Epoch;
Report "Now is:" to Console;
Report Truth_sc.Epoch to Console;


// String TLE_pos_err_output_filename = ".\\pos_error_data\\TLE_abs_pos_error_" + ID + "_" + SpaceCraftName + ".csv";
// String OD_pos_err_output_filename = ".\\pos_error_data\\OD_abs_pos_error_" + ID + "_" + SpaceCraftName + ".csv";
// Variable elapsed_seconds = 0; // will be incremented by 10 seconds each step
// 
// 
// 
// // report interfaces for rms files
// ReportInterface TLE_pos_err_Interface(TLE_pos_err_output_filename);
// Report "elapsed time [s];abs. position error [km]" to TLE_pos_err_Interface without headers without pad;
// ReportInterface OD_pos_err_Interface(OD_pos_err_output_filename);
// Report "elapsed time [s];abs. position error [km]" to OD_pos_err_Interface without headers without pad;
// 
// // exporting the position error generates more information than already rms, allows to change bin size in python later on
// Variable TLE_abs_pos_error;
// Variable OD_abs_pos_error;
While (OD_sc.ElapsedTime <= TIMESPAN(5 days));
// Pull the state vector data out of the ephemeris object
Truth_sc.Position = truth_ephemeris.GetInterpolatedVectorData(Truth_sc.Epoch, {0,1,2});
// TLE_abs_pos_error = sqrt((TLE_sc.Position[0] - Truth_sc.Position[0])^2 + 
// 					     (TLE_sc.Position[1] - Truth_sc.Position[1])^2 + 
// 					     (TLE_sc.Position[2] - Truth_sc.Position[2])^2);
// 					
