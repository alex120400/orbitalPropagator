	Update AzimuthComparisonPlot;
	Update ElevationComparisonPlot;
	
End;

Update AlongTrackSeparationPlot;
Update CrossTrackSeparationPlot;
Update ViewWindow1;
Step Truth_sc;
Step TLE_sc to (TLE_sc.Epoch == Truth_sc.Epoch);
Step OD_sc to (OD_sc.Epoch == Truth_sc.Epoch);
End;]]></ProjectScript>
