  <ProjectScript><![CDATA[// Console Setup
Console.DockMode = 3;
Console.Dimension = 40;
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Lime;
Console.WordWrap = 1;
Console.Show();
// define 
FF_SolarSystem.DefaultEarthOrientationParametersFile = "../Support_Files/earth_orientation_parameters_celestrak.csv";

String SpaceCraftName = "STELLA";
String OD_samples_file = "./observation_data/pseudo_pointobservations_3d_STELLA_blackjack.txt";
String ID = "3d";
Report SpaceCraftName, ID to Console;
ApiLabel "Python-Input";

String truth_FFephem_file;
If (SpaceCraftName == "STELLA");
	truth_FFephem_file = "./ephemeris/stella.FFEphem";
	
ElseIf (SpaceCraftName == "STARLETTE");
	truth_FFephem_file = "./ephemeris/starlette.FFEphem";
	
ElseIf (SpaceCraftName == "LAGEOS-1");
	truth_FFephem_file = "./ephemeris/lageos-1.FFEphem";
	
ElseIf (SpaceCraftName == "STARLETTE");
	truth_FFephem_file = "./ephemeris/starlette.FFEphem";
	
ElseIf (SpaceCraftName == "COSMOS-2024-(ETALON-2)");	
	truth_FFephem_file = "./ephemeris/cosmos-2024-(etalon-2).FFEphem";
	
ElseIf (SpaceCraftName == "COSMOS-1989-(ETALON-1)");	
	truth_FFephem_file = "./ephemeris/cosmos-1989-(etalon-1).FFEphem";
	
ElseIf (SpaceCraftName == "AJISAI-(EGS)");	
	truth_FFephem_file = "./ephemeris/ajisai-(EGS).FFEphem";
	
ElseIf (SpaceCraftName == "LARES");	
	truth_FFephem_file = "./ephemeris/lares.FFEphem";
	
ElseIf (SpaceCraftName == "LARETS");	
	truth_FFephem_file = "./ephemeris/larets.FFEphem";
	
Else;
	truth_FFephem_file = "spacecrafte name not found";
End;

