Variable numObs2 = GSObs2.Count;
Variable az_sc;
Variable alt_sc;
Variable alt_truth;
Variable az_truth;

For i = 0 to numObs2-1;
	Epoch = GSObs2[i].ObservedEpoch;
	Step Spacecraft1 to (Spacecraft1.Epoch == Epoch);
	az_sc = MPEI_OGS.Azimuth(Spacecraft1);
	alt_sc = MPEI_OGS.Elevation(Spacecraft1);
	
	az_truth = deg(GSObs2[i].Azimuth.ObservedValue);
	alt_truth = deg(GSObs2[i].Elevation.ObservedValue);
	alt_diff = (alt_sc-alt_truth)*3600;
	az_diff = (az_sc-az_truth)*3600;
	
	Update AltPropWindow;
	Update AzPropWindow;
	//Call ReportToASAStructure(Spacecraft1,MPEI_OGS,ASATrackingData);
End;
/*
/*
// Propagate Solution and Compare with Truth
While (Spacecraft1.ElapsedTime < TIMESPAN(3 minutes));
	Step Spacecraft1;
	Call ReportToASAStructure(Spacecraft1,MPEI_OGS,ASATrackingData);
End;
*/
/*
While (EstimatedSC.ElapsedTime < TIMESPAN(1 days));

	Step EstimatedSC;
	Step TruthSC to (TruthSC.Epoch == EstimatedSC.Epoch);

	Update OrbitSeparationsPlot;

End;
*/]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Reports of sc parameters, comp setup</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// OD_sc now has the updated state
// spacecraft already configured with correct propagator
Report "OD SC has propagator and its epoch is: " to Console;
Report OD_sc.PropagatorType to Console;
Report OD_sc.Epoch to Console;

Report "TLE SC has propagator and its epoch is: " to Console;
Report TLE_sc.PropagatorType to Console;
Report TLE_sc.Epoch to Console;
Step TLE_sc to (TLE_sc.Epoch == OD_sc.Epoch);
Report "Now is, plus state:" to Console;
Report TLE_sc.Epoch to Console;
Report TLE_sc.Position, TLE_sc.Velocity to Console;

Report "Truth SC has propagator and its epoch was: " to Console;
Report Truth_sc.PropagatorType to Console;
Report Truth_sc.Epoch to Console;
// Step Truth_sc to (Truth_sc.Epoch == OD_sc.Epoch); // not good here, assign it rather and get position in loop step
Truth_sc.Epoch = OD_sc.Epoch;
Report "Now is:" to Console;
Report Truth_sc.Epoch to Console;

]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="false">
        <Label>Setup abs pos error output</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[String TLE_pos_err_output_filename = ".\\pos_error_data\\TLE_abs_pos_error_" + ID + "_" + SpaceCraftName + ".csv";
String OD_pos_err_output_filename = ".\\pos_error_data\\OD_abs_pos_error_" + ID + "_" + SpaceCraftName + ".csv";
Variable elapsed_seconds = 0; // will be incremented by 10 seconds each step



// report interfaces for rms files
ReportInterface TLE_pos_err_Interface(TLE_pos_err_output_filename);
Report "elapsed time [s];abs. position error [km]" to TLE_pos_err_Interface without headers without pad;
ReportInterface OD_pos_err_Interface(OD_pos_err_output_filename);
Report "elapsed time [s];abs. position error [km]" to OD_pos_err_Interface without headers without pad;

// exporting the position error generates more information than already rms, allows to change bin size in python later on
Variable TLE_abs_pos_error;
Variable OD_abs_pos_error;]]></FreeFormScript>
      </FreeForm>
      <WhileCommand enabled="true" collapsed="false">
        <While name="Command10" isConstant="false" isGlobal="false">
          <Name>Command10</Name>
          <Condition>
            <LogicalExpression name="Command10_:Condition" isConstant="false" isGlobal="false">
              <Name>Command10_:Condition</Name>
              <LHS xsi:nil="true" />
              <RHS>
                <LogicalCondition name="Command10_:Condition_:RHS" isConstant="false" isGlobal="false">
                  <Name>Command10_:Condition_:RHS</Name>
                  <ConditionType>RelExprDbl</ConditionType>
                  <Condition>
                    <RelationalExprReal name="Command10_:Condition_:RHS_:Condition" isConstant="false" isGlobal="false">
                      <Name>Command10_:Condition_:RHS_:Condition</Name>
                      <LHS>
                        <EventCall name="Command10_:Condition_:RHS_:Condition_:LHS" isConstant="false" isGlobal="false">
                          <Name>Command10_:Condition_:RHS_:Condition_:LHS</Name>
                          <BaseObject>OD_sc</BaseObject>
                          <EventName>ElapsedTime</EventName>
                          <Parameters dim="0" />
                          <metadata dim="0" />
                        </EventCall>
                      </LHS>
                      <RHS>
                        <TimeSpanConstant name="Command10_:Condition_:RHS_:Condition_:RHS" isConstant="false" isGlobal="false">
                          <Name>Command10_:Condition_:RHS_:Condition_:RHS</Name>
                          <value>5</value>
                          <Units>days</Units>
                          <metadata dim="0" />
                        </TimeSpanConstant>
                      </RHS>
                      <Operator>&lt;=</Operator>
                      <metadata dim="0" />
                    </RelationalExprReal>
                  </Condition>
                  <metadata dim="0" />
                </LogicalCondition>
              </RHS>
              <Operator>and</Operator>
              <metadata dim="0" />
            </LogicalExpression>
          </Condition>
          <metadata dim="0" />
        </While>
        <FreeForm enabled="true">
          <Label>Set Truth_sc position acording to current epoch</Label>
          <Bookmarks />
          <Breakpoints />
          <FreeFormScript><![CDATA[// Pull the state vector data out of the ephemeris object
Truth_sc.Position = truth_ephemeris.GetInterpolatedVectorData(Truth_sc.Epoch, {0,1,2});]]></FreeFormScript>
        </FreeForm>
        <FreeForm enabled="false">
          <Label>abs pos error calculation</Label>
          <Bookmarks />
          <Breakpoints />
          <FreeFormScript><![CDATA[TLE_abs_pos_error = sqrt((TLE_sc.Position[0] - Truth_sc.Position[0])^2 + 
					     (TLE_sc.Position[1] - Truth_sc.Position[1])^2 + 
					     (TLE_sc.Position[2] - Truth_sc.Position[2])^2);
					
OD_abs_pos_error =  sqrt((OD_sc.Position[0] - Truth_sc.Position[0])^2 + 
				         (OD_sc.Position[1] - Truth_sc.Position[1])^2 + 
				         (OD_sc.Position[2] - Truth_sc.Position[2])^2);
				  

Report elapsed_seconds, ";", TLE_abs_pos_error to TLE_pos_err_Interface without headers without pad;

Report elapsed_seconds, ";", OD_abs_pos_error to OD_pos_err_Interface without headers without pad;

elapsed_seconds += 10;]]></FreeFormScript>
        </FreeForm>
        <FreeForm enabled="true">
          <Label>groundstation contact</Label>
          <Bookmarks />
          <Breakpoints />
          <FreeFormScript><![CDATA[If ((MPEI_OGS.Elevation(OD_sc) > MPEI_OGS.ConeElevation) and (MPEI_OGS.Elevation(TLE_sc) > MPEI_OGS.ConeElevation)
	and (MPEI_OGS.Elevation(Truth_sc) > MPEI_OGS.ConeElevation));
