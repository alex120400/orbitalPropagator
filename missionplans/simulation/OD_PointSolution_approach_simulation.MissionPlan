//		GroundStationObservations[i].UseElevation = 1;
//		GroundStationObservations[i].UseRange     = 0;
//		GroundStationObservations[i].UseRangeRate = 0;
//		GroundStationObservations[i].UseRightAscension = 0;
//		GroundStationObservations[i].UseDeclination = 0;
